# ==========================================================================
# STMC Launchpad — environment variables
# Copy this file to .env.local for local dev, and set the same keys in
# Netlify: Site settings → Environment variables.
# All NEXT_PUBLIC_* values are exposed to the browser bundle — never put
# a private key or secret in a NEXT_PUBLIC_ variable. The Supabase keys
# below are server-only and must never be prefixed with NEXT_PUBLIC_.
# ==========================================================================

# Solana RPC endpoint used by the app. Use your own RPC provider
# (Helius, QuickNode, Triton, etc.) for production — public mainnet
# endpoints are rate-limited and unreliable for token creation traffic.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# "mainnet-beta" | "devnet" — controls Solscan/DEX Screener link targets,
# the network badge in the wallet button, and which cluster transactions
# are sent to. This app is configured for mainnet-beta by default — real
# SOL is at stake. Set to "devnet" while testing.
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta

# Wallet that receives the 1% STMC platform fee. Public key only —
# this is not a secret, it's just an address.
NEXT_PUBLIC_FEE_WALLET=29rzSKdRC1aqNcCeyxc9PHbmPE6ru6qcQjjcMezhrEFF

# Platform fee, in basis points. 100 = 1%. Kept configurable so the
# fee can be changed later without a code change.
NEXT_PUBLIC_FEE_BPS=100

# Optional: if you wire up a real image host for logos (Arweave/IPFS/S3),
# put the upload endpoint here. Left unset, the app stores the logo as a
# base64 data URI directly in the token metadata JSON (fine for an MVP,
# not recommended for permanent/production metadata).
NEXT_PUBLIC_IMAGE_UPLOAD_ENDPOINT=

# --------------------------------------------------------------------------
# Supabase — stores token-creation history keyed by wallet address.
# Create a free project at https://supabase.com, then run
# lib/db-schema.sql in the SQL editor to create the table.
# Both variables below are read only on the server (API routes) and are
# intentionally NOT prefixed with NEXT_PUBLIC_.
# --------------------------------------------------------------------------

# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Service role key — SERVER-ONLY, full read/write access, bypasses row
# level security. Used exclusively inside app/api/tokens/route.ts to
# verify a wallet signature before writing, and to read a wallet's
# portfolio. NEVER expose this in a NEXT_PUBLIC_ variable or client code.
SUPABASE_SERVICE_ROLE_KEY=
